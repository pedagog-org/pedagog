  "query": "SELECT id, email, name, role FROM users\n            WHERE ($1::text IS NULL OR role = $1)\n              AND ($2::text IS NULL OR email = $2\n                   OR email ILIKE $3 ESCAPE '\\' OR name ILIKE $3 ESCAPE '\\')\n            ORDER BY COALESCE(email = $2, false) DESC, email\n            LIMIT $4 OFFSET $5",
