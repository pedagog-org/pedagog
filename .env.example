CF_API_TOKEN=           # Cloudflare API token with Zone:DNS:Edit permission
POSTGRES_PW=            # Strong password for the pedagog Postgres user
SMTP_USER=              # Only if your mail relay wants a login (else leave empty)
SMTP_PASSWORD=
GLITCHTIP_DB_PW=        # Strong password for GlitchTip's Postgres role
GLITCHTIP_ADMIN_EMAIL=  # GlitchTip's superuser (signs in to its UI, invites others)
GLITCHTIP_ADMIN_PW=     # Their password
GLITCHTIP_EMAIL_URL=    # smtp://[user:password@]relay:port, for GlitchTip's alert emails
