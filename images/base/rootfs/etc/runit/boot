#!/bin/sh
# PID 1. Run one-time setup, then hand off to runsvdir, which supervises the
# services in /etc/service, reaps orphaned processes, and exits cleanly on
# SIGTERM (so `podman stop` is prompt). We don't use runit's staged PID 1
# binary: its stage-3 shutdown calls reboot(), which needs CAP_SYS_BOOT and
# so hangs under rootless podman.
set -e
/etc/runit/1
# Lock the firewall: drop net_admin (and setpcap, so the bounding set can't be
# changed back) from the bounding set. Every later exec re-derives caps from the
# bounding set, so afterwards no process -- not even a root one -- can alter nft.
# setuid/setgid stay so chpst can drop services to their uids. Requires the
# container to start with caps NET_ADMIN, SETPCAP, SETUID, SETGID.
exec setpriv --bounding-set=-net_admin,-setpcap runsvdir -P /etc/service
