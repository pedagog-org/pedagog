#!/bin/sh
# One-time setup under CAP_NET_ADMIN, before supervision starts: load the student
# egress firewall. boot drops the cap from the bounding set immediately after, so
# no setuid-root path can regain it for the session. A missing or invalid ruleset
# aborts boot (fail closed) — better no session than unfiltered egress.
set -e
nft -f /pedagog/config/nftables.conf
