# syntax=docker/dockerfile:1

# Build the static `pedagog` CLI (musl, statically linked) in a throwaway stage.
# Build context is the repo root: `podman build -f images/base/Containerfile .`
FROM docker.io/library/rust:1.88-alpine AS build
RUN apk add --no-cache musl-dev gcc
WORKDIR /src
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
# Cache the cargo registry and target dir across builds. target/ lives in the
# cache mount (not the layer), so copy the binary out to a persisted path.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --bin pedagog \
 && cp target/release/pedagog /usr/local/bin/pedagog

# Base image: runs code-server in the browser as an unprivileged `student` user.
FROM cgr.dev/chainguard/wolfi-base:latest

ARG CODE_SERVER_VERSION=4.125.0
# Set by `podman build` from --platform (e.g. amd64, arm64).
ARG TARGETARCH

# A shell for code-server's launcher, TLS roots, the C++ runtime its bundled Node needs,
# shadow (useradd), curl to install, runit (PID 1 supervisor), nftables (egress
# firewall), and setpriv (drops caps at boot; the dedicated package, since busybox's
# applet lacks --bounding-set). (tar comes from the base busybox.)
RUN apk add --no-cache bash ca-certificates libstdc++ libgcc shadow curl runit nftables setpriv

# code-server from the upstream standalone release (bundles its own glibc Node).
RUN curl -fsSL \
      "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-${TARGETARCH}.tar.gz" \
      -o /tmp/code-server.tar.gz \
 && mkdir -p /usr/lib/code-server \
 && tar -xzf /tmp/code-server.tar.gz -C /usr/lib/code-server --strip-components=1 \
 && ln -sf /usr/lib/code-server/bin/code-server /usr/bin/code-server \
 && rm /tmp/code-server.tar.gz

# Identities: student (untrusted) works in the editor; pedagog (trusted broker)
# will hold the token and own egress; instructor owns the source tree. The pedagogc
# group gates the daemon socket (clients allowed to connect).
RUN groupadd --gid 1001 student \
 && groupadd --gid 1002 pedagog \
 && groupadd --gid 1003 instructor \
 && groupadd --gid 1100 pedagogc \
 && useradd --uid 1001 --gid student    --groups pedagogc --shell /bin/bash      --home-dir /pedagog/student --no-create-home student \
 && useradd --uid 1002 --gid pedagog                      --shell /sbin/nologin  --home-dir /pedagog         --no-create-home pedagog \
 && useradd --uid 1003 --gid instructor --groups pedagogc --shell /sbin/nologin  --home-dir /pedagog/source  --no-create-home instructor

# Work tree under /pedagog. student/ is the student home (a named volume at
# runtime; build just sets the mountpoint owner). source/ (instructor inputs:
# manifest + seed files) is instructor-owned, group pedagog so the daemon can
# read seeds; staging/ (submission packaging) is pedagog-only; config/ holds
# resolved state (e.g. nftables.conf), root-owned, group pedagog. All hidden
# from student.
RUN mkdir -p /pedagog/student /pedagog/source /pedagog/staging /pedagog/config \
 && chmod 0755 /pedagog \
 && chown student:student     /pedagog/student && chmod 0700 /pedagog/student \
 && chown instructor:pedagog  /pedagog/source  && chmod 0750 /pedagog/source \
 && chown pedagog:pedagog     /pedagog/staging && chmod 0700 /pedagog/staging \
 && chown root:pedagog        /pedagog/config  && chmod 0750 /pedagog/config

# Keep code-server's runtime state out of the student's work folder so the workspace
# stays clean and is never captured by archives/submissions.
RUN mkdir -p /var/lib/code-server/data/User \
             /var/lib/code-server/extensions \
             /var/lib/code-server/cache \
             /var/lib/code-server/share \
 && chown -R student:student /var/lib/code-server

# Lock the extensions dir read-only so students cannot add/remove extensions; pre-seed
# the empty manifest code-server expects.
RUN printf '[]' > /var/lib/code-server/extensions/extensions.json \
 && chown -R root:root /var/lib/code-server/extensions \
 && chmod -R a=rX /var/lib/code-server/extensions

# Locked-down default settings (telemetry off, no online lookups, no auto-update).
COPY --chown=student:student images/base/settings.json /var/lib/code-server/data/User/settings.json

# Disable the extension marketplace; relocate the last stray cache/data dirs out of the
# work folder.
ENV EXTENSIONS_GALLERY={} \
    XDG_CACHE_HOME=/var/lib/code-server/cache \
    XDG_DATA_HOME=/var/lib/code-server/share

EXPOSE 8080

# The pedagog admin/authoring CLI, baked from the build stage. Instructor/root
# only (0750 root:instructor) — never executable by student.
COPY --from=build --chown=root:instructor --chmod=0750 /usr/local/bin/pedagog /usr/bin/pedagog

# Bake a fail-closed default egress ruleset (no manifest yet -> default-deny). The
# per-assignment build overwrites it via `pedagog image network compile`.
RUN pedagog image network compile

# Boot model: a tiny PID 1 (/etc/runit/boot) runs one-time setup, then execs
# runsvdir to supervise the services in /etc/service. code-server drops to the
# student uid via chpst. Scripts live in rootfs/.
COPY images/base/rootfs/ /

ENTRYPOINT ["/etc/runit/boot"]
