# Download the latest arm64 .deb from our code-server fork into this directory.
# gh skips draft releases by default, so we resolve the tag explicitly first.
vendor:
    #!/usr/bin/env bash
    set -euo pipefail
    tag=$(gh release list --repo RobertConde/code-server --limit 1 --json tagName --jq '.[0].tagName')
    echo "Downloading $tag..."
    gh release download "$tag" \
        --repo RobertConde/code-server \
        --pattern 'code-server_*_arm64.deb' \
        --output code-server.deb \
        --clobber

# Build the test container image. Requires vendor to have run first.
build:
    podman build --security-opt label=disable -t code-server-test .
