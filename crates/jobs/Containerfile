# Multi-stage jobs image. Build context is the repo root:
#   podman build -f crates/jobs/Containerfile -t <ref> .
#
# build   -> compile the jobs + hammer binaries (sqlx offline via committed .sqlx/)
# vend    -> hammer vend the pinned recipes (fetch ingredients at image-build time)
# runtime -> slim image with the binary + baked recipes at /opt/pedagog/recipes
#
# hammer is a build-time tool only; it is not in the runtime image.
#
# Cache mounts keep crates.io downloads, compiled dependencies and vended
# ingredients between builds, so a code change recompiles only the workspace
# and pinned ingredients aren't downloaded again.

FROM docker.io/library/rust:1.97.1-bookworm AS build
WORKDIR /src
COPY . .
ENV SQLX_OFFLINE=true
# A cache mount isn't part of the image, so the binaries are copied out of it.
RUN --mount=type=cache,id=pedagog-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pedagog-jobs-target,target=/src/target \
    cargo build --release --locked -p pedagog-jobs -p hammer \
    && mkdir -p /out && cp target/release/pedagog-jobs target/release/hammer /out/

FROM build AS vend
# Needs network + the recipes' pinned upstream tags. Baked so Kaniko builds are hermetic.
# Ingredients with a pinned checksum are reused from the cache when they still match.
RUN --mount=type=cache,id=pedagog-ingredients,target=/src/recipes/ingredients \
    /out/hammer vend --recipes /src/recipes --quiet \
    && cp -a /src/recipes/ingredients /out/ingredients

FROM docker.io/library/debian:stable-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/pedagog-jobs /usr/local/bin/pedagog-jobs
COPY --from=vend  /src/recipes /opt/pedagog/recipes
COPY --from=vend  /out/ingredients /opt/pedagog/recipes/ingredients
ENV PEDAGOG_RECIPES_DIR=/opt/pedagog/recipes
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/pedagog-jobs"]
