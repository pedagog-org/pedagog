# Multi-stage jobs image. Build context is the repo root:
#   podman build -f crates/jobs/Containerfile -t <ref> .
#
# build   -> compile the jobs binary (sqlx offline via committed .sqlx/)
# init    -> pedagog/jobs-init: only the binary, for test-run and build pods'
#            initContainers (await-egress, fetch-context, fetch-ingredients):
#              podman build -f crates/jobs/Containerfile --target init -t <ref> .
# runtime -> pedagog/jobs (the default target): the binary + the pinned recipes
#            at /opt/pedagog/recipes. Their ingredients aren't baked: jobs keeps
#            them in Garage, and builds fetch what they declare.
#
# Cache mounts keep crates.io downloads and compiled dependencies between
# builds, so a code change recompiles only the workspace.

FROM docker.io/library/rust:1.97.1-bookworm AS build
WORKDIR /src
COPY . .
ENV SQLX_OFFLINE=true
# A cache mount isn't part of the image, so the binary is copied out of it.
RUN --mount=type=cache,id=pedagog-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pedagog-jobs-target,target=/src/target \
    cargo build --release --locked -p pedagog-jobs \
    && mkdir -p /out && cp target/release/pedagog-jobs /out/

# Built against Debian 12's glibc (rust:*-bookworm), as is this base.
FROM gcr.io/distroless/cc-debian12:nonroot AS init
COPY --from=build /out/pedagog-jobs /usr/local/bin/pedagog-jobs
ENTRYPOINT ["/usr/local/bin/pedagog-jobs"]

FROM docker.io/library/debian:stable-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/pedagog-jobs /usr/local/bin/pedagog-jobs
# (.containerignore leaves out recipes/ingredients.)
COPY recipes /opt/pedagog/recipes
ENV PEDAGOG_RECIPES_DIR=/opt/pedagog/recipes
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/pedagog-jobs"]
